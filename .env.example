# InvoiceGenie environment template — copy to .env and fill secrets.
# NEVER commit real secrets. .env is gitignored.

# --- OWASP / security scanning ---
NVD_API_KEY=

# --- Postgres (production / docker-compose) ---
POSTGRES_USER=ar
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=invoicegenie
QUARKUS_DATASOURCE_USERNAME=ar
QUARKUS_DATASOURCE_PASSWORD=change-me-strong-password
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/invoicegenie

# --- API security (required when quarkus.profile=prod) ---
INVOICEGENIE_SECURITY_ENABLED=true
# api-key | jwt | hybrid | oidc (oidc = optional PP-020 path when implemented)
INVOICEGENIE_SECURITY_MODE=hybrid
# Format: apiKey:tenantUuid  (comma-separated for multiple)
INVOICEGENIE_API_KEYS=dev-local-key:00000000-0000-0000-0000-000000000001
# HS256 secret for web JWT login (min 16 chars in %prod; use long random in real staging/prod)
INVOICEGENIE_JWT_SECRET=replace-with-long-random-secret-min-16
# Access JWT lifetime seconds (application.yml default 900 = 15m; longer values ok for demos)
INVOICEGENIE_JWT_ACCESS_TTL_SECONDS=900
# Legacy alias for access TTL (still read by some compose stacks)
INVOICEGENIE_JWT_TTL_SECONDS=900
# Refresh token lifetime seconds (default 604800 = 7d)
INVOICEGENIE_JWT_REFRESH_TTL_SECONDS=604800
# Web users: username:password:tenantUuid:ROLE1|ROLE2 (comma-separated)
# Roles: AR_CLERK, AR_CONTROLLER, AR_AUDITOR, TENANT_ADMIN
# Prefer DB users + bootstrap after first boot; this list is optional M2M/demo
INVOICEGENIE_SECURITY_USERS=clerk:change-me:00000000-0000-0000-0000-000000000001:AR_CLERK|AR_AUDITOR,admin:change-me:00000000-0000-0000-0000-000000000001:TENANT_ADMIN|AR_CONTROLLER|AR_CLERK|AR_AUDITOR
INVOICEGENIE_SECURITY_ALLOW_OPENAPI=false

# First-boot admin (only when ar_app_user is empty) — change immediately in shared envs
INVOICEGENIE_BOOTSTRAP_EMAIL=admin@invoicegenie.local
INVOICEGENIE_BOOTSTRAP_PASSWORD=Admin123!
INVOICEGENIE_BOOTSTRAP_DISPLAY_NAME=System Admin
INVOICEGENIE_BOOTSTRAP_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- OIDC / enterprise SSO (PP-020 — optional; wire when security.mode includes oidc) ---
# Leave unset for hybrid/jwt/api-key pilots.
# INVOICEGENIE_OIDC_ENABLED=false
# QUARKUS_OIDC_AUTH_SERVER_URL=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# QUARKUS_OIDC_CLIENT_ID=
# QUARKUS_OIDC_CREDENTIALS_SECRET=
# QUARKUS_OIDC_APPLICATION_TYPE=service
# Expected issuer / audience if validating external JWTs without full code flow:
# INVOICEGENIE_OIDC_ISSUER=
# INVOICEGENIE_OIDC_AUDIENCE=
# Web console redirect (when browser OIDC login is enabled):
# NEXT_PUBLIC_OIDC_AUTHORITY=
# NEXT_PUBLIC_OIDC_CLIENT_ID=
# NEXT_PUBLIC_OIDC_REDIRECT_URI=https://app.example.com/login/callback

# --- Public base URL (edge HTTPS origin for links / provider webhooks) ---
# Used for unsubscribe footers, PDF links, Meta/SES webhook callbacks when those features ship.
INVOICEGENIE_PUBLIC_BASE_URL=https://localhost
# Web-facing origin if different from API:
# NEXT_PUBLIC_APP_URL=https://localhost

# --- Customer notifications (Email + WhatsApp) ---
# See docs/deploy/EMAIL_DELIVERABILITY.md and docs/deploy/WHATSAPP_META_SETUP.md
INVOICEGENIE_NOTIFICATIONS_ENABLED=true
INVOICEGENIE_NOTIFICATIONS_LOG_PAYLOADS=false
INVOICEGENIE_NOTIFICATIONS_SEND_RATE_PER_MINUTE=30
INVOICEGENIE_NOTIFICATIONS_PRE_DUE_DAYS=3
INVOICEGENIE_NOTIFICATIONS_MAX_ATTEMPTS=5
INVOICEGENIE_NOTIFICATIONS_DISPATCH_INTERVAL=15s
INVOICEGENIE_NOTIFICATIONS_DISPATCH_BATCH=50
INVOICEGENIE_NOTIFICATIONS_REMINDER_JOB_INTERVAL=1h

# Email: provider=logging (demo SENT) | smtp (fail-closed until PP-001 transport)
INVOICEGENIE_NOTIFICATIONS_EMAIL_ENABLED=true
INVOICEGENIE_NOTIFICATIONS_EMAIL_PROVIDER=logging
INVOICEGENIE_SMTP_HOST=none
INVOICEGENIE_SMTP_PORT=587
INVOICEGENIE_SMTP_USERNAME=none
INVOICEGENIE_SMTP_PASSWORD=none
INVOICEGENIE_SMTP_FROM=noreply@invoicegenie.local
INVOICEGENIE_SMTP_STARTTLS=true

# WhatsApp: provider=logging (demo) | meta (fail-closed until PP-002 client)
INVOICEGENIE_NOTIFICATIONS_WHATSAPP_ENABLED=false
INVOICEGENIE_NOTIFICATIONS_WHATSAPP_PROVIDER=logging
INVOICEGENIE_WHATSAPP_ACCESS_TOKEN=none
INVOICEGENIE_WHATSAPP_PHONE_NUMBER_ID=none
INVOICEGENIE_WHATSAPP_API_VERSION=v18.0
# Meta webhook verification (PP-003 provider webhooks — planned)
# INVOICEGENIE_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-random-verify-token
# INVOICEGENIE_WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# --- Web ---
BACKEND_URL=http://app:8080
NEXT_PUBLIC_APP_NAME=InvoiceGenie AR
# Production must be false — hide free tenant UUID override; require /login session
NEXT_PUBLIC_ALLOW_TENANT_OVERRIDE=false
NEXT_PUBLIC_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Prefer login page over embedding keys. Optional fallback only for demos:
# NEXT_PUBLIC_API_KEY=

# --- Runtime ---
QUARKUS_HTTP_PORT=8080
QUARKUS_PROFILE=prod

# --- Optional observability / outbox ---
# QUARKUS_OTEL_ENABLED=false
# QUARKUS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OUTBOX_KAFKA_ENABLED=false
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
