# InvoiceGenie environment template — copy to .env and fill secrets.
# NEVER commit real secrets. .env is gitignored.

# --- OWASP / security scanning ---
NVD_API_KEY=

# --- Postgres (production / docker-compose) ---
POSTGRES_USER=ar
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=invoicegenie
QUARKUS_DATASOURCE_USERNAME=ar
QUARKUS_DATASOURCE_PASSWORD=change-me-strong-password
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/invoicegenie

# --- API security (required when quarkus.profile=prod) ---
INVOICEGENIE_SECURITY_ENABLED=true
# api-key | jwt | hybrid | oidc | hybrid-oidc
# hybrid = local HS256 JWT login + API keys; hybrid-oidc also accepts IdP RS256 JWTs
INVOICEGENIE_SECURITY_MODE=hybrid
# Format: apiKey:tenantUuid  (comma-separated for multiple)
INVOICEGENIE_API_KEYS=dev-local-key:00000000-0000-0000-0000-000000000001
# HS256 secret for web JWT login (min 16 chars in %prod)
INVOICEGENIE_JWT_SECRET=replace-with-long-random-secret-min-16
# Optional JWT lifetime seconds (default 28800 = 8h)
INVOICEGENIE_JWT_TTL_SECONDS=28800
# Web users: username:password:tenantUuid:ROLE1|ROLE2 (comma-separated)
# Roles: AR_CLERK, AR_CONTROLLER, AR_AUDITOR, TENANT_ADMIN
INVOICEGENIE_SECURITY_USERS=clerk:change-me:00000000-0000-0000-0000-000000000001:AR_CLERK|AR_AUDITOR,admin:change-me:00000000-0000-0000-0000-000000000001:TENANT_ADMIN|AR_CONTROLLER|AR_CLERK|AR_AUDITOR
INVOICEGENIE_SECURITY_ALLOW_OPENAPI=false

# --- OIDC resource server (PP-020; required when mode=oidc|hybrid-oidc) ---
# INVOICEGENIE_OIDC_ISSUER=https://login.example.com/realms/invoicegenie
# INVOICEGENIE_OIDC_JWKS_URI=https://login.example.com/realms/invoicegenie/protocol/openid-connect/certs
# INVOICEGENIE_OIDC_AUDIENCE=invoicegenie-ar
# Claim that carries tenant UUID (default tenant_id)
# INVOICEGENIE_OIDC_TENANT_CLAIM=tenant_id
# Claim for roles/groups (default groups) — mapped to AR_CLERK|AR_CONTROLLER|AR_AUDITOR|TENANT_ADMIN
# INVOICEGENIE_OIDC_ROLES_CLAIM=groups

# --- Payments (PP-024) ---
# When true, allow allocating a payment to invoices in a different currency via exchange rates
INVOICEGENIE_PAYMENTS_ALLOW_FX_ALLOCATION=false

# --- Web ---
BACKEND_URL=http://app:8080
NEXT_PUBLIC_APP_NAME=InvoiceGenie AR
# Production must be false — hide free tenant UUID override; require /login session
NEXT_PUBLIC_ALLOW_TENANT_OVERRIDE=false
NEXT_PUBLIC_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Prefer login page over embedding keys. Optional fallback only for demos:
# NEXT_PUBLIC_API_KEY=

# --- Runtime ---
QUARKUS_HTTP_PORT=8080
QUARKUS_PROFILE=prod

# --- Notifications (PP-001 SMTP / PP-002 Meta / PP-003 suppressions / PP-004 fallback) ---
INVOICEGENIE_NOTIFICATIONS_ENABLED=true
INVOICEGENIE_NOTIFICATIONS_EMAIL_ENABLED=true
# logging (demo) | smtp (real)
INVOICEGENIE_NOTIFICATIONS_EMAIL_PROVIDER=logging
INVOICEGENIE_NOTIFICATIONS_WHATSAPP_ENABLED=false
# logging (demo) | meta (WhatsApp Cloud API)
INVOICEGENIE_NOTIFICATIONS_WHATSAPP_PROVIDER=logging
INVOICEGENIE_NOTIFICATIONS_CHANNEL_FALLBACK_ENABLED=false
# Shared secret for POST /api/v1/notifications/provider-webhooks/{ses|smtp-generic|meta}
INVOICEGENIE_NOTIFICATIONS_PROVIDER_WEBHOOK_SECRET=change-me-provider-webhook-secret

# SMTP (when EMAIL_PROVIDER=smtp)
INVOICEGENIE_SMTP_HOST=none
INVOICEGENIE_SMTP_PORT=587
INVOICEGENIE_SMTP_USERNAME=none
INVOICEGENIE_SMTP_PASSWORD=none
INVOICEGENIE_SMTP_FROM=noreply@invoicegenie.local
INVOICEGENIE_SMTP_STARTTLS=true

# Meta WhatsApp Cloud API (when WHATSAPP_PROVIDER=meta)
INVOICEGENIE_WHATSAPP_ACCESS_TOKEN=none
INVOICEGENIE_WHATSAPP_PHONE_NUMBER_ID=none
INVOICEGENIE_WHATSAPP_API_VERSION=v18.0
INVOICEGENIE_WHATSAPP_LANGUAGE_CODE=en
